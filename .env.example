POSTGRES_DB=crypto_market
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

# Telegram
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=@channel_username

# VK publishing
VK_ENABLED=true
VK_API_VERSION=5.199

VK_ACCESS_TOKEN=PASTE_YOUR_VK_TOKEN_HERE

# ID сообщества БЕЗ минуса
# Например, если ссылка на пост будет wall-123456789_1,
# то VK_GROUP_ID=123456789
VK_GROUP_ID=PASTE_YOUR_GROUP_ID_HERE

# Пока true, чтобы не публиковать случайно
VK_DRY_RUN=true

# Публиковать от имени сообщества
VK_POST_AS_GROUP=true

# Пока не закрываем комментарии автоматически
VK_CLOSE_COMMENTS=false

# Tailscale
TAILSCALE_AUTHKEY=
TAILSCALE_EXIT_NODE=

# Telegram traffic goes through Telegram-only gateway over Tailscale
TELEGRAM_PROXY_URL=http://tailscale:8080

# Scheduler
SCHEDULER_SYMBOL=BTCUSDT
SCHEDULER_INTERVAL=60
SCHEDULER_TIMEZONE=UTC
SCHEDULER_NOTIFY=false

SCHEDULER_SNAPSHOT_ENABLED=true
SCHEDULER_SNAPSHOT_CRON_HOURS=0,4,8,12,16,20
SCHEDULER_SNAPSHOT_CRON_MINUTE=5

SCHEDULER_DEEP_DIVE_ENABLED=true
SCHEDULER_DEEP_DIVE_CRON_HOURS=9,18
SCHEDULER_DEEP_DIVE_CRON_MINUTE=20

SCHEDULER_ALERT_ENABLED=true
SCHEDULER_ALERT_CRON_HOURS=*
SCHEDULER_ALERT_CRON_MINUTE=*/30
SCHEDULER_ALERT_NO_EVENT_OK=true

# Enable after ETHUSDT/SOLUSDT candles + indicators are ready.
SCHEDULER_DAILY_SUMMARY_ENABLED=false
SCHEDULER_DAILY_SUMMARY_SYMBOLS=BTCUSDT ETHUSDT SOLUSDT
SCHEDULER_DAILY_SUMMARY_CRON_HOURS=7,19
SCHEDULER_DAILY_SUMMARY_CRON_MINUTE=10

SCHEDULER_TUTORIAL_ENABLED=false
SCHEDULER_TUTORIAL_DAY_OF_WEEK=mon,thu
SCHEDULER_TUTORIAL_CRON_HOURS=11
SCHEDULER_TUTORIAL_CRON_MINUTE=0

SCHEDULER_RELEASE_NOTE_ENABLED=false
SCHEDULER_RELEASE_NOTE_DAY_OF_WEEK=fri
SCHEDULER_RELEASE_NOTE_CRON_HOURS=12
SCHEDULER_RELEASE_NOTE_CRON_MINUTE=0
